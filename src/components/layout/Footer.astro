---
---
<footer class="relative border-t border-neutral-200 dark:border-neutral-800 bg-white/50 dark:bg-neutral-950/50 backdrop-blur-2xl" role="contentinfo">
  <div class="container-custom py-space-2xl lg:py-space-3xl">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-space-2xl mb-space-2xl">
      <div class="lg:col-span-1">
        <a href="/" class="block w-fit mb-6" aria-label="Guatgames - Home">
          <img src="/images/favico.jpeg" alt="Guatgames" class="w-12 h-12 rounded-xl object-cover dark:hidden" width="48" height="48" loading="lazy" />
          <img src="/images/favico-dark.jpeg" alt="Guatgames" class="w-12 h-12 rounded-xl object-cover hidden dark:block" width="48" height="48" loading="lazy" />
        </a>
        <p class="text-body-md text-neutral-600 dark:text-neutral-400 mb-6 leading-relaxed" data-i18n="footer.tagline">
          Creative Developer &amp; Designer building delightful digital experiences with code and creativity.
        </p>
        <div class="flex items-center gap-4" role="list" aria-label="Social links">
          <a href="https://github.com/guatgames" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <a href="https://linkedin.com/in/guatgames" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="mailto:adalfaroochoa@gmail.com" class="social-link" aria-label="Email">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
        </div>
      </div>
      
      <nav class="lg:col-span-1" aria-label="Quick links">
        <h3 class="font-display text-heading-sm font-bold text-neutral-900 dark:text-neutral-100 mb-6" data-i18n="footer.quickLinks">Quick Links</h3>
        <ul class="space-y-3" role="list">
          <li><a href="#about" class="footer-link" data-i18n="navigation.about">About</a></li>
          <li><a href="#projects" class="footer-link" data-i18n="navigation.projects">Projects</a></li>
          <li><a href="#technologies" class="footer-link" data-i18n="navigation.technologies">Technologies</a></li>
          <li><a href="#blog" class="footer-link" data-i18n="navigation.blog">Blog</a></li>
          <li><a href="#contact" class="footer-link" data-i18n="navigation.contact">Contact</a></li>
        </ul>
      </nav>
      
      <nav class="lg:col-span-1" aria-label="Resources">
        <h3 class="font-display text-heading-sm font-bold text-neutral-900 dark:text-neutral-100 mb-6" data-i18n="footer.resources">Resources</h3>
        <ul class="space-y-3" role="list">
          <li><a href="/resume.pdf" class="footer-link" target="_blank" rel="noopener noreferrer" data-i18n="footer.resume">Resume</a></li>
          <li><a href="https://github.com/guatgames" class="footer-link" target="_blank" rel="noopener noreferrer">GitHub</a></li>
        </ul>
      </nav>
      
      <div class="lg:col-span-1">
        <h3 class="font-display text-heading-sm font-bold text-neutral-900 dark:text-neutral-100 mb-6" data-i18n="footer.contact">Contact</h3>
        <address class="not-italic space-y-3 text-body-md text-neutral-600 dark:text-neutral-400">
          <p data-i18n="footer.availableFor">Available for freelance &amp; full-time opportunities</p>
          <a href="mailto:adalfaroochoa@gmail.com" class="footer-link block">a...@gmail.com</a>
          <p class="text-caption text-neutral-500 dark:text-neutral-500" data-i18n="footer.responseTime">Typically responds within 24-48 hours</p>
        </address>
      </div>
    </div>
    
    <div class="pt-8 border-t border-neutral-200 dark:border-neutral-800">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-body-sm text-neutral-500 dark:text-neutral-500" data-i18n="footer.copyright" data-i18n-params={JSON.stringify({ year: new Date().getFullYear(), name: 'Angel Alfaro' })}>
          © {new Date().getFullYear()} Angel Alfaro. All rights reserved.
        </p>
        <div class="flex items-center gap-6 text-caption text-neutral-500 dark:text-neutral-500">
          <span data-i18n="footer.builtWith" data-i18n-params={JSON.stringify({ tech: 'Astro 5 & Tailwind CSS' })}>Built with Astro 5 &amp; Tailwind CSS</span>
          <span data-i18n="footer.deployedOn" data-i18n-params={JSON.stringify({ platform: 'Netlify' })}>Deployed on Netlify</span>
          <a href="https://github.com/guatgames/portfolio" target="_blank" rel="noopener noreferrer" class="hover:text-brand-500 dark:hover:text-brand-400 transition-colors" data-i18n="footer.sourceCode">
            Source code available on GitHub
          </a>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Animated background elements -->

</footer>

<style>
  .social-link {
    @apply w-10 h-10 flex items-center justify-center rounded-xl bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 transition-all duration-300 hover:bg-brand-500 hover:text-white hover:shadow-lg hover:shadow-brand-500/30;
  }
  
  .footer-link {
    @apply text-body-md text-neutral-600 dark:text-neutral-400 hover:text-brand-500 dark:hover:text-brand-400 transition-colors;
  }
</style>