---
import LanguageToggle from '../ui/LanguageToggle.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import MobileMenuButton from '../ui/MobileMenuButton.astro';
import MobileMenu from '../ui/MobileMenu.astro';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/80 dark:bg-neutral-950/80 backdrop-blur-2xl border-b border-neutral-200/50 dark:border-neutral-800/50 transition-all duration-500">
  <nav class="container-custom" aria-label="Main navigation">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <div class="flex items-center gap-8">
        <a href="/" class="font-display text-heading-lg font-bold gradient-text" aria-label="Guatgames - Home">
          G
        </a>
        
        <ul class="hidden lg:flex items-center gap-1" role="menubar">
          <li role="none">
            <a href="#about" class="nav-link" role="menuitem" data-i18n="navigation.about">About</a>
          </li>
          <li role="none">
            <a href="#projects" class="nav-link" role="menuitem" data-i18n="navigation.projects">Projects</a>
          </li>
          <li role="none">
            <a href="#technologies" class="nav-link" role="menuitem" data-i18n="navigation.technologies">Technologies</a>
          </li>
          <li role="none">
            <a href="#blog" class="nav-link" role="menuitem" data-i18n="navigation.blog">Blog</a>
          </li>
          <li role="none">
            <a href="#contact" class="nav-link" role="menuitem" data-i18n="navigation.contact">Contact</a>
          </li>
        </ul>
      </div>

      <div class="flex items-center gap-4">
        <LanguageToggle />
        <ThemeToggle />
        <MobileMenuButton />
      </div>
    </div>

    <MobileMenu />
  </nav>
</header>

<script>
  // Smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      const targetId = this.getAttribute('href');
      if (targetId === '#') return;
      
      const target = document.querySelector(targetId);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        target.focus({ preventScroll: true });
        
        // Close mobile menu if open
        const mobileMenu = document.querySelector('.mobile-menu');
        if (mobileMenu?.classList.contains('open')) {
          mobileMenu.classList.remove('open');
          document.body.style.overflow = '';
        }
      }
    });
  });

  // Header scroll effect
  let lastScrollY = window.scrollY;
  const header = document.querySelector('header');
  
  window.addEventListener('scroll', () => {
    const currentScrollY = window.scrollY;
    
    if (currentScrollY > 100) {
      header?.classList.add('bg-white/90', 'dark:bg-neutral-950/90', 'shadow-lg');
    } else {
      header?.classList.remove('bg-white/90', 'dark:bg-neutral-950/90', 'shadow-lg');
    }
    
    if (currentScrollY > lastScrollY && currentScrollY > 200) {
      header?.classList.add('-translate-y-full');
    } else {
      header?.classList.remove('-translate-y-full');
    }
    
    lastScrollY = currentScrollY;
  }, { passive: true });
</script>

<style>
  .nav-link {
    @apply relative px-3 py-2 text-body-sm font-medium text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors;
  }
  
  .nav-link::after {
    @apply content-[''] absolute bottom-0 left-1/2 w-0 h-0.5 bg-brand-500 transition-all duration-300;
    transition-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
    transform: translateX(-50%);
  }
  
  .nav-link:hover::after,
  .nav-link.active::after {
    @apply w-3/4;
  }
  
  header {
    @apply transition-transform duration-300;
    transition-timing-function: cubic-bezier(0.19, 1, 0.22, 1);
  }
</style>