---
import LanguageToggle from '../ui/LanguageToggle.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import MobileMenuButton from '../ui/MobileMenuButton.astro';
import MobileMenu from '../ui/MobileMenu.astro';
---

<header class="site-header fixed top-0 left-0 right-0 z-50 border-b-2 border-[var(--color-border-primary)] transition-all duration-300">
  <nav class="container-custom" aria-label="Main navigation" data-i18n-attr="aria-label:navigation.mainNav">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <div class="flex items-center gap-8">

        <a href="/" class="block shrink-0" aria-label="Guatgames - Home">
          <img src="/images/favico.jpeg" alt="Guatgames" class="w-8 h-8 lg:w-9 lg:h-9 object-cover dark:hidden" width="40" height="40" loading="eager" />
          <img src="/images/favico-dark.jpeg" alt="Guatgames" class="w-8 h-8 lg:w-9 lg:h-9 object-cover hidden dark:block" width="40" height="40" loading="eager" />
        </a>

        <ul class="hidden lg:flex items-center gap-1">
          <li>
            <a href="#about" class="nav-link" data-i18n="navigation.about">About</a>
          </li>
          <li>
            <a href="#projects" class="nav-link" data-i18n="navigation.projects">Projects</a>
          </li>
          <li>
            <a href="#technologies" class="nav-link" data-i18n="navigation.technologies">Technologies</a>
          </li>
          <li>
            <a href="#blog" class="nav-link" data-i18n="navigation.blog">Blog</a>
          </li>
          <li>
            <a href="#contact" class="nav-link" data-i18n="navigation.contact">Contact</a>
          </li>
        </ul>
      </div>

      <div class="flex items-center gap-4">
        <LanguageToggle />
        <ThemeToggle />
        <MobileMenuButton />
      </div>
    </div>

    <MobileMenu />
  </nav>
</header>

<script>
  // Smooth scroll for section links. The global `scroll-behavior: smooth`
  // already animates the default anchor jump, so this only keeps the URL hash
  // in sync and moves focus for assistive tech — without cancelling navigation.
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      const targetId = this.getAttribute('href');
      if (!targetId || targetId === '#' || targetId === location.hash) return;

      const target = document.querySelector(targetId);
      if (!target) return;

      // Reflect the section in the URL (deep-linkable, back button works).
      history.pushState(null, '', targetId);
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      target.focus({ preventScroll: true });
    });
  });

  // Header scroll effect
  let lastScrollY = window.scrollY;
  const header = document.querySelector('header');
  
  window.addEventListener('scroll', () => {
    const currentScrollY = window.scrollY;
    
    if (currentScrollY > 100) {
      header?.classList.add('is-scrolled');
    } else {
      header?.classList.remove('is-scrolled');
    }
    
    if (currentScrollY > lastScrollY && currentScrollY > 200) {
      header?.classList.add('-translate-y-full');
    } else {
      header?.classList.remove('-translate-y-full');
    }
    
    lastScrollY = currentScrollY;
  }, { passive: true });
</script>

<style>
  .site-header {
    background-color: var(--color-bg-primary);
    box-shadow: none;
    backdrop-filter: none;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--color-border-secondary);
  }

  .nav-link {
    @apply relative px-3 py-2 text-body-sm font-medium text-neutral-600 dark:text-[var(--color-text-tertiary)] hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0.35rem;
    left: 0.75rem;
    right: 0.75rem;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 250ms cubic-bezier(0.19, 1, 0.22, 1);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  header {
    transition: transform 300ms cubic-bezier(0.19, 1, 0.22, 1), border-color 300ms ease;
  }
</style>