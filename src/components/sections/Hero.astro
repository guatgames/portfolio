---
---

<section id="hero" class="relative min-h-screen flex items-center section" aria-labelledby="hero-title">
  <div class="container-custom relative z-10 py-24 lg:py-32">
    <div class="grid lg:grid-cols-[minmax(0,1.55fr)_minmax(18rem,0.85fr)] gap-14 lg:gap-16 items-end">
      <!-- Left: the name and the offer, set like an editorial masthead. -->
      <div class="text-left" data-animate="slide-up" data-delay="100">
        <h1 id="hero-title" class="font-display mb-7" data-animate="text-reveal" data-delay="300">
          <span class="block text-display-md font-medium text-[var(--color-text-tertiary)] dark:text-[var(--color-text-tertiary)]" data-i18n="hero.greeting">Hi, I'm</span>
          <span class="block text-display-xl font-extrabold" data-i18n="hero.name">Angel Alfaro</span>
        </h1>

        <p class="text-body-lg text-neutral-600 dark:text-[var(--color-text-tertiary)] max-w-xl mb-10" data-animate="slide-up" data-delay="400" data-i18n="hero.tagline">
          Creative Developer &amp; Designer
        </p>

        <div class="flex flex-col sm:flex-row items-start gap-6 mb-14" data-animate="slide-up" data-delay="500">
          <a href="#projects" class="group inline-flex items-center gap-2 text-body-sm font-semibold border-b border-current pb-1">
            <span data-i18n="hero.ctaPrimary">View Projects</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="#contact" class="group inline-flex items-center gap-2 text-body-sm font-semibold border-b border-current pb-1">
            <span data-i18n="hero.ctaSecondary">Get in Touch</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
        </div>

        <!-- Statistics read as an index row, not a set of metric cards. -->
        <div class="grid grid-cols-3 gap-6 md:gap-10" data-animate="fade-in" data-delay="600" data-stagger="150">
          <div class="stat-cell" data-stagger-child="slide-up">
            <div class="stat-value" data-counter="5" data-counter-suffix="+">0</div>
            <div class="stat-label" data-i18n="hero.stats.years">Years Learning</div>
          </div>
          <div class="stat-cell" data-stagger-child="slide-up">
            <div class="stat-value" data-counter="5" data-counter-suffix="+">0</div>
            <div class="stat-label" data-i18n="hero.stats.projects">Projects Completed</div>
          </div>
          <div class="stat-cell" data-stagger-child="slide-up">
            <div class="stat-value" data-counter="27" data-counter-suffix="+">0</div>
            <div class="stat-label" data-i18n="hero.stats.technologies">Technologies</div>
          </div>
        </div>

        <div class="flex items-center gap-3 mt-10 pt-5 border-t-2 border-[var(--color-border-primary)]" data-animate="fade-in" data-delay="700">
          <span class="w-1.5 h-1.5 bg-[var(--color-text-primary)]" aria-hidden="true"></span>
          <span class="meta-label" data-i18n="hero.availability">Now open for freelance projects</span>
        </div>
      </div>

      <!-- Right: a flat ledger of facts. -->
      <div class="lg:border-l-2 lg:border-[var(--color-border-primary)] lg:pl-10" data-animate="slide-up" data-delay="400">
        <div data-parallax="0.08">
          <div class="ledger-head">
            <span class="meta-label">v1.0</span>
          </div>
          <div class="ledger-code pt-5" aria-label="Developer profile code specimen">
            <div><span class="code-key">const</span> <span>developer</span> <span class="code-punct">= {</span></div>
            <div class="pl-4"><span class="code-key">name</span><span class="code-punct">:</span> <span class="code-value">"Guatgames"</span><span class="code-punct">,</span></div>
            <div class="pl-4"><span class="code-key">role</span><span class="code-punct">:</span> <span class="code-value">"Creative Developer"</span><span class="code-punct">,</span></div>
            <div class="pl-4"><span class="code-key">stack</span><span class="code-punct">:</span> <span class="code-value">["Astro", "React", "Tailwind"]</span><span class="code-punct">,</span></div>
            <div class="pl-4"><span class="code-key">focus</span><span class="code-punct">:</span> <span class="code-value">"Building delightful UX"</span><span class="code-punct">,</span></div>
            <div class="code-punct">}</div>
          </div>
          <div class="flex items-center gap-3 pt-6 mt-6 border-t-2 border-[var(--color-border-primary)]">
            <span class="w-6 h-0.5 bg-[var(--color-border-secondary)]" aria-hidden="true"></span>
            <span class="meta-label" data-i18n="hero.openTo">Open to opportunities</span>
          </div>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex items-center gap-3 text-[var(--color-text-tertiary)] dark:text-[var(--color-text-tertiary)]" data-animate="fade-in" data-delay="1000" aria-hidden="true">
      <span class="meta-label" data-i18n="hero.scrollHint">Scroll to explore</span>
      <span class="w-10 h-px bg-current"></span>
    </div>
  </div>
</section>

<script>
  // Parallax on mouse move for hero visual.
  // The centered card is positioned with Tailwind translate classes
  // (-translate-x/y-1/2), so the base transform is captured once and
  // recombined with DOMMatrix on every move instead of being overwritten.
  const floatingCards = document.querySelectorAll<HTMLElement>('#hero [data-parallax]');

  floatingCards.forEach((card) => {
    card.dataset.baseTransform = (getComputedStyle(card).transform || 'none');
  });

  if (floatingCards.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.addEventListener('mousemove', (e) => {
      const x = (e.clientX / window.innerWidth - 0.5) * 2;
      const y = (e.clientY / window.innerHeight - 0.5) * 2;

      floatingCards.forEach((card, index) => {
        const factor = (index + 1) * 5;
        const base = new DOMMatrix(card.dataset.baseTransform || 'none');
        // Keep the layout transform, then apply the tiny mouse offset on top.
        card.style.transform = base.translate(x * factor, y * factor).toString();
      });
    });
  }
</script>
