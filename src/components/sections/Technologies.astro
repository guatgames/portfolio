---
import { getCollection } from 'astro:content';
import TechCard from '../ui/TechCard.astro';

const techData = await getCollection('technologies');
const technologies = techData[0]?.data || [];

// Group by category
const categories = [
  { key: 'framework', label: 'Frameworks', icon: 'framework' },
  { key: 'library', label: 'Libraries', icon: 'library' },
  { key: 'language', label: 'Languages', icon: 'language' },
  { key: 'tool', label: 'Tools', icon: 'tool' },
  { key: 'platform', label: 'Platforms', icon: 'platform' },
  { key: 'database', label: 'Databases', icon: 'database' },
  { key: 'other', label: 'Other', icon: 'other' },
];

const categoryIcons: Record<string, string> = {
  framework: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>',
  library: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>',
  language: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>',
  tool: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /></svg>',
  platform: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" /></svg>',
  database: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4" /></svg>',
  other: '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>',
};

const categoryColors: Record<string, string> = {
  framework: 'brand',
  library: 'accent-cyan',
  language: 'accent-magenta',
  tool: 'accent-lime',
  platform: 'accent-orange',
  database: 'accent-pink',
  other: 'neutral',
};

const categoryBgClasses: Record<string, string> = {
  brand: 'bg-brand-500/10',
  'accent-cyan': 'bg-accent-cyan/10',
  'accent-magenta': 'bg-accent-magenta/10',
  'accent-lime': 'bg-accent-lime/10',
  'accent-orange': 'bg-accent-orange/10',
  'accent-pink': 'bg-accent-pink/10',
  neutral: 'bg-neutral-500/10',
};
---

<section id="technologies" class="section" aria-labelledby="technologies-title">
  <div class="container-custom">
    <div class="section-header" data-animate="slide-up" data-delay="100">
      <span class="badge-primary mb-4" data-animate="fade-in" data-delay="200" data-i18n="technologies.title">Technologies</span>
      <h2 id="technologies-title" class="section-title" data-animate="text-reveal" data-delay="300" data-i18n="technologies.subtitle">Tools & technologies I work with</h2>
      <p class="section-subtitle" data-animate="fade-in" data-delay="400" data-i18n="technologies.description">
        A comprehensive overview of the technologies, frameworks, and tools I use to build modern applications.
      </p>
    </div>
    
    <div class="space-y-16">
      {categories.map((category, catIndex) => {
        const categoryTechs = technologies.filter((t: any) => t.category === category.key);
        if (categoryTechs.length === 0) return null;
        
        const color = categoryColors[category.key];
        
        return (
          <div class="tech-category" data-animate="slide-up" data-delay={String((catIndex + 1) * 100)}>
            <div class="flex items-center gap-3 mb-8">
              <span class={`w-12 h-12 rounded-xl ${categoryBgClasses[color] || 'bg-neutral-500/10'} flex items-center justify-center`}>
                <span set:html={categoryIcons[category.key] || categoryIcons.other}></span>
              </span>
              <h3 class="font-display text-heading-lg font-bold text-neutral-900 dark:text-neutral-100" data-i18n={`technologies.categories.${category.key}`}>{category.label}</h3>
              <span class="badge badge-primary ml-auto">{categoryTechs.length}</span>
            </div>
            
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4" data-reveal data-reveal-stagger="80">
              {categoryTechs.map((tech: any, index) => (
                <TechCard tech={tech} color={color} index={index} />
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .tech-category {
    @apply space-y-8;
  }
</style>