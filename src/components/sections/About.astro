---
import SkillBar from '../ui/SkillBar.astro';
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container-custom">
    <div class="section-header" data-animate="slide-up" data-delay="100">
      <span class="badge-primary mb-4" data-animate="fade-in" data-delay="200" data-i18n="about.title">About Me</span>
      <h2 id="about-title" class="section-title p-4" data-animate="text-reveal" data-delay="300" data-i18n="about.subtitle">Get to know the person behind the code</h2>
      <p class="section-subtitle" data-animate="fade-in" data-delay="400" data-i18n="about.tagline">
        I'm a passionate developer with a love for creating beautiful, functional, and accessible digital experiences.
      </p>
    </div>
    
    <div class="grid lg:grid-cols-2 gap-space-2xl lg:gap-space-4xl items-start">
      <!-- Left: Bio & Description -->
      <div class="space-y-8" data-animate="slide-up" data-delay="200">
        <div class="space-y-6" data-animate="fade-in" data-delay="300" data-stagger="150">
          <p class="text-body-lg text-neutral-700 dark:text-neutral-300 leading-relaxed" data-stagger-child="fade-in" data-i18n="about.bio1">
            I am a lover of technology and programming, with a strong focus on web development. I enjoy building interactive and user-friendly applications that solve real-world problems. My journey in tech has been driven by curiosity, continuous learning, and a desire to make a positive impact through code.
          </p>
          <p class="text-body-lg text-neutral-700 dark:text-neutral-300 leading-relaxed" data-stagger-child="fade-in" data-i18n="about.bio2">
            I knew about programming when I was 11 years old, after that, I started learning programming and web development. I have been working on different projects, from small personal projects to larger applications. I am always looking for new challenges and opportunities to grow as a developer.
          </p>
        </div>
        
        <!-- Highlights -->
        <div class="grid grid-cols-2 gap-4" data-animate="fade-in" data-delay="400" data-stagger="100">
          <div class="card card-hover p-6" data-stagger-child="slide-up">
            <div class="w-12 h-12 rounded-xl bg-brand-500/10 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="font-display text-heading-sm font-bold text-neutral-900 dark:text-neutral-100 mb-2" data-i18n="about.highlightYears">5+ Years Learning</h3>
            <p class="text-body-md text-neutral-600 dark:text-neutral-400" data-i18n="about.highlightYearsDesc">Continuous learning and skill development</p>
          </div>
          
          <div class="card card-hover p-6" data-stagger-child="slide-up">
            <div class="w-12 h-12 rounded-xl bg-accent-cyan/10 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-accent-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <h3 class="font-display text-heading-sm font-bold text-neutral-900 dark:text-neutral-100 mb-2" data-i18n="about.highlightOpenSource">Open Source Contributor</h3>
            <p class="text-body-md text-neutral-600 dark:text-neutral-400" data-i18n="about.highlightOpenSourceDesc">Active in the community with 100+ contributions</p>
          </div>
          
          <div class="card card-hover p-6" data-stagger-child="slide-up">
            <div class="w-12 h-12 rounded-xl bg-accent-magenta/10 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-accent-magenta" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <h3 class="font-display text-heading-sm font-bold text-neutral-900 dark:text-neutral-100 mb-2" data-i18n="about.highlightMentor">Leader &amp; Speaker</h3>
            <p class="text-body-md text-neutral-600 dark:text-neutral-400" data-i18n="about.highlightMentorDesc">Helping partners achieve their goals in the programming world</p>
          </div>
          
          <div class="card card-hover p-6" data-stagger-child="slide-up">
            <div class="w-12 h-12 rounded-xl bg-accent-lime/10 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-accent-lime" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <h3 class="font-display text-heading-sm font-bold text-neutral-900 dark:text-neutral-100 mb-2" data-i18n="about.highlightLearner">Lifelong Learner</h3>
            <p class="text-body-md text-neutral-600 dark:text-neutral-400" data-i18n="about.highlightLearnerDesc">Constantly exploring new technologies &amp; patterns</p>
          </div>
        </div>
        
        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 pt-4" data-animate="slide-up" data-delay="500">
          <a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="btn-primary group">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span data-i18n="about.downloadResume">Download Resume</span>
          </a>
          <a href="https://linkedin.com/in/guatgames" target="_blank" rel="noopener noreferrer" class="btn-secondary group">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            <span data-i18n="about.viewLinkedIn">Connect on LinkedIn</span>
          </a>
        </div>
      </div>
      
      <!-- Right: Skills & Interests -->
      <div class="space-y-10" data-animate="slide-up" data-delay="400">
        <!-- Core Skills -->
        <div data-animate="fade-in" data-delay="300">
          <h3 class="font-display text-heading-lg font-bold text-neutral-900 dark:text-neutral-100 mb-6 flex items-center gap-3">
            <span class="w-10 h-10 rounded-xl bg-brand-500/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </span>
            <span data-i18n="about.skills">Core Skills</span>
          </h3>
          
          <div class="space-y-6">
            <div class="skill-category" data-animate="slide-up" data-delay="100">
              <div class="flex items-center gap-2 mb-4">
                <span class="w-8 h-8 rounded-lg bg-brand-500/10 flex items-center justify-center">
                  <svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                  </svg>
                </span>
                <h4 class="font-display text-heading-sm font-bold text-neutral-900 dark:text-neutral-100" data-i18n="about.skillCategories.frontend">Frontend</h4>
              </div>
              <div class="flex flex-wrap gap-3">
                <SkillBar name="Astro" color="brand" />
                <SkillBar name="React" color="accent-cyan" />
                <SkillBar name="TypeScript" color="accent-cyan" />
                <SkillBar name="Tailwind CSS" color="accent-cyan" />
                <SkillBar name="Vue.js" color="accent-lime" />
                <SkillBar name="Svelte" color="accent-orange" />
              </div>
            </div>
            
            <div class="skill-category" data-animate="slide-up" data-delay="200">
              <div class="flex items-center gap-2 mb-4">
                <span class="w-8 h-8 rounded-lg bg-accent-lime/10 flex items-center justify-center">
                  <svg class="w-5 h-5 text-accent-lime" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
                  </svg>
                </span>
                <h4 class="font-display text-heading-sm font-bold text-neutral-900 dark:text-neutral-100" data-i18n="about.skillCategories.backend">Backend</h4>
              </div>
              <div class="flex flex-wrap gap-3">
                <SkillBar name="Node.js" color="accent-lime" />
                <SkillBar name="Deno" color="accent-orange" />
                <SkillBar name="PostgreSQL" color="accent-magenta" />
                <SkillBar name="MongoDB" color="accent-lime" />
                <SkillBar name="GraphQL" color="accent-magenta" />
                <SkillBar name="REST APIs" color="brand" />
              </div>
            </div>
            
            <div class="skill-category" data-animate="slide-up" data-delay="300">
              <div class="flex items-center gap-2 mb-4">
                <span class="w-8 h-8 rounded-lg bg-accent-magenta/10 flex items-center justify-center">
                  <svg class="w-5 h-5 text-accent-magenta" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </span>
                <h4 class="font-display text-heading-sm font-bold text-neutral-900 dark:text-neutral-100" data-i18n="about.skillCategories.devops">Tools &amp; DevOps</h4>
              </div>
              <div class="flex flex-wrap gap-3">
                <SkillBar name="Git/GitHub" color="accent-magenta" />
                <SkillBar name="Docker" color="accent-cyan" />
                <SkillBar name="CI/CD" color="brand" />
                <SkillBar name="Vercel/Netlify" color="accent-cyan" />
                <SkillBar name="AWS" color="accent-orange" />
                <SkillBar name="Testing (Vitest/Playwright)" color="accent-lime" />
              </div>
            </div>
          </div>
        </div>
        
        <!-- Interests -->
        <div data-animate="fade-in" data-delay="400">
          <h3 class="font-display text-heading-lg font-bold text-neutral-900 dark:text-neutral-100 mb-6 flex items-center gap-3">
            <span class="w-10 h-10 rounded-xl bg-accent-cyan/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-accent-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
              </svg>
            </span>
            <span data-i18n="about.interests">When not coding</span>
          </h3>
          
          <div class="flex flex-wrap gap-3" data-stagger="80">
            
            <span class="interest-tag">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
              Video Games
            </span>
            <span class="interest-tag">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21a9 9 0 100-18 9 9 0 000 18zm0 0c2.5-2.4 3.75-5.4 3.75-9S14.5 5.4 12 3m0 18c-2.5-2.4-3.75-5.4-3.75-9S9.5 5.4 12 3M3 12h18" />
              </svg>
              Play Basketball
            </span>
            <span class="interest-tag">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Mechanical Keyboards
            </span>
            <span class="interest-tag">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2" />
              </svg>
              Play Guitar
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .skill-category {
    @apply space-y-3;
  }
  
  .skill-chip {
    @apply inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-caption font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-700 transition-all duration-300 hover:border-brand-500/50 dark:hover:border-brand-500/50 hover:bg-brand-500/5 dark:hover:bg-brand-500/5;
  }
  
  .skill-chip-dot {
    @apply w-2 h-2 rounded-full shrink-0;
  }
  
  .interest-tag {
    @apply inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-caption font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-700 transition-all duration-300 hover:border-brand-500/50 dark:hover:border-brand-500/50 hover:bg-brand-500/5 dark:hover:bg-brand-500/5;
  }
  
  .interest-tag svg {
    @apply shrink-0;
  }
</style>