---
import { getCollection } from 'astro:content';
import BlogCard from '../ui/BlogCard.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestPosts = sortedPosts.slice(0, 3);
---

<section id="blog" class="section" aria-labelledby="blog-title">
  <div class="container-custom">
    <div class="section-header" data-animate="slide-up" data-delay="100">
      <span class="badge-primary mb-4" data-animate="fade-in" data-delay="200" data-i18n="blog.title">Blog</span>
      <h2 id="blog-title" class="section-title" data-animate="text-reveal" data-delay="300" data-i18n="blog.subtitle">Thoughts, tutorials, and insights</h2>
      <p class="section-subtitle" data-animate="fade-in" data-delay="400" data-i18n="blog.description">
        Sharing knowledge about web development, design, and technology.
      </p>
    </div>
    
    {latestPosts.length > 0 ? (
      <>
        <div class="grid lg:grid-cols-3 gap-8 mb-16" data-reveal data-reveal-stagger="150" role="list" aria-label="Latest blog posts">
          {latestPosts.map((post, index) => (
            <BlogCard post={post} featured={index === 0} index={index} />
          ))}
        </div>
        
        <div class="text-center" data-animate="fade-in" data-delay="300">
          <a href="/blog" class="btn-secondary group inline-flex items-center gap-2">
            <span data-i18n="blog.allPosts">View All Posts</span>
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </>
    ) : (
      <div class="text-center py-16" data-animate="fade-in" data-delay="200">
        <div class="w-20 h-20 rounded-2xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center mx-auto mb-6">
          <svg class="w-10 h-10 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
        </div>
        <h3 class="font-display text-heading-md font-bold text-neutral-900 dark:text-neutral-100 mb-2">No posts yet</h3>
        <p class="text-body-md text-neutral-600 dark:text-neutral-400 mb-6">Start writing to share your thoughts with the world!</p>
        <a href="/blog/new" class="btn-primary">Write Your First Post</a>
      </div>
    )}
  </div>
</section>