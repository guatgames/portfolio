---
import { getCollection } from 'astro:content';
import ProjectCard from '../ui/ProjectCard.astro';

type Project = Awaited<ReturnType<typeof getCollection<'projects'>>>[number];

const allProjects = await getCollection('projects', ({ data }) => !data.draft);

// Spanish entries live under `es/` in the collection; everything else is English.
const localeOf = (slug: string): 'en' | 'es' => (slug.startsWith('es/') ? 'es' : 'en');
const baseOf = (slug: string): string => (slug.startsWith('es/') ? slug.slice(3) : slug);

const byLocale = (locale: 'en' | 'es') =>
  allProjects.filter((p) => localeOf(p.slug) === locale).sort((a, b) => a.data.order - b.data.order);

const enProjects = byLocale('en');
const esProjects = byLocale('es');

// Pair every English project with its Spanish twin (fall back to the English
// entry when a translation is missing so a card never disappears).
function pairs(en: Project[], es: Project[]): { en: Project; es: Project }[] {
  return en.map((enEntry) => ({
    en: enEntry,
    es: es.find((entry) => baseOf(entry.slug) === baseOf(enEntry.slug)) || enEntry,
  }));
}

const featuredPairs = pairs(enProjects.filter((p) => p.data.featured), esProjects.filter((p) => p.data.featured));
const otherPairs = pairs(enProjects.filter((p) => !p.data.featured), esProjects.filter((p) => !p.data.featured));
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="container-custom">
    <div class="section-header" data-animate="slide-up" data-delay="100">
      <span class="badge-primary mb-4" data-animate="fade-in" data-delay="200" data-i18n="projects.title">Projects</span>
      <h2 id="projects-title" class="section-title" data-animate="text-reveal" data-delay="300" data-i18n="projects.subtitle">A selection of my recent work</h2>
      <p class="section-subtitle" data-animate="fade-in" data-delay="400" data-i18n="projects.description">
        From side projects to production applications, here are some highlights from my portfolio.
      </p>
    </div>
    
    <!-- Featured Projects -->
    {featuredPairs.length > 0 && (
      <div class="mb-space-2xl" data-animate="slide-up" data-delay="300">
        <h3 class="font-display text-heading-lg font-bold text-neutral-900 dark:text-neutral-100 mb-8 flex items-center gap-3">
          <span class="w-8 h-8 rounded-lg bg-brand-500/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-brand-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          </span>
          <span data-i18n="projects.featuredSection">Featured Projects</span>
        </h3>
        
        <div class="grid lg:grid-cols-2 gap-8" role="list" aria-label="Featured projects">
          {featuredPairs.map(({ en, es }, index) => (
            <Fragment>
              <div data-i18n-content="en">
                <ProjectCard project={en} featured={true} index={index} />
              </div>
              <div data-i18n-content="es" hidden>
                <ProjectCard project={es} featured={true} index={index} />
              </div>
            </Fragment>
          ))}
        </div>
      </div>
    )}
    
    <!-- All Projects -->
    <div data-animate="slide-up" data-delay="400" data-reveal data-reveal-stagger="100">
      <h3 class="font-display text-heading-lg font-bold text-neutral-900 dark:text-neutral-100 mb-8 flex items-center gap-3">
        <span class="w-8 h-8 rounded-lg bg-accent-cyan/10 flex items-center justify-center">
          <svg class="w-5 h-5 text-accent-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </span>
        <span data-i18n="projects.allSection">All Projects</span>
      </h3>
      
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" role="list" aria-label="All projects">
        {otherPairs.map(({ en, es }, index) => (
          <Fragment>
            <div data-i18n-content="en">
              <ProjectCard project={en} featured={false} index={index} />
            </div>
            <div data-i18n-content="es" hidden>
              <ProjectCard project={es} featured={false} index={index} />
            </div>
          </Fragment>
        ))}
        {enProjects.length === 0 && (
          <div class="col-span-full text-center py-12">
            <div class="w-16 h-16 rounded-2xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            </div>
            <h3 class="font-display text-heading-md font-bold text-neutral-900 dark:text-neutral-100 mb-2" data-i18n="projects.noProjects">No projects yet</h3>
            <p class="text-body-md text-neutral-600 dark:text-neutral-400" data-i18n="projects.noProjectsHint">Add some projects to your portfolio to get started!</p>
          </div>
        )}
      </div>
    </div>
  </div>
</section>