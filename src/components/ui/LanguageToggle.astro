---
---
<div class="relative" data-lang-toggle>
  <!-- Trigger -->
  <button
    type="button"
    class="btn-icon relative overflow-hidden"
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label="Select language"
    data-lang-toggle-btn
    data-i18n-attr="aria-label:language.select"
  >
    <span class="relative z-10 flex items-center gap-1.5">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
      </svg>
      <span class="hidden sm:inline font-mono text-caption uppercase tracking-wider" data-lang-label>EN</span>
    </span>
    <span class="absolute inset-0 bg-brand-500 scale-x-0 origin-right transition-transform duration-300 ease-out-expo" aria-hidden="true"></span>
  </button>

  <!-- Dropdown -->
  <div
    class="absolute right-0 top-full mt-2 w-48 origin-top-right rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700 shadow-2xl shadow-neutral-950/10 overflow-hidden z-50 opacity-0 invisible scale-y-95 transition-all duration-200 ease-out-expo"
    role="menu"
    aria-label="Select language"
    data-lang-toggle-dropdown
    data-i18n-attr="aria-label:language.select"
  >
    <div class="px-4 pt-3 pb-2 text-caption uppercase tracking-wider font-mono text-neutral-400 dark:text-neutral-500" data-i18n="language.select">Select language</div>

    <button
      type="button"
      class="lang-option w-full px-4 py-3 text-left flex items-center gap-3 transition-colors hover:bg-neutral-100 dark:hover:bg-neutral-800"
      role="menuitemradio"
      aria-checked="false"
      data-lang="en"
    >
      <span class="lang-option-code">EN</span>
      <span class="flex-1 font-medium text-neutral-900 dark:text-neutral-100" data-i18n="language.english">English</span>
      <svg class="lang-option-check w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
      </svg>
    </button>

    <button
      type="button"
      class="lang-option w-full px-4 py-3 text-left flex items-center gap-3 transition-colors hover:bg-neutral-100 dark:hover:bg-neutral-800"
      role="menuitemradio"
      aria-checked="false"
      data-lang="es"
    >
      <span class="lang-option-code">ES</span>
      <span class="flex-1 font-medium text-neutral-900 dark:text-neutral-100" data-i18n="language.spanish">Español</span>
      <svg class="lang-option-check w-4 h-4 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
      </svg>
    </button>
  </div>
</div>

<script>
  // Multi-instance safe: the header and the mobile menu each render this
  // component. Every [data-lang-toggle] group is wired independently.
  function getActiveLocale(): 'en' | 'es' {
    const attr = document.documentElement.getAttribute('data-locale');
    return (window.I18N?.locale || (attr === 'es' ? 'es' : 'en')) as 'en' | 'es';
  }

  function wireLanguageToggle(group: HTMLElement) {
    const toggle = group.querySelector<HTMLButtonElement>('[data-lang-toggle-btn]');
    const dropdown = group.querySelector<HTMLElement>('[data-lang-toggle-dropdown]');
    const options = Array.from(group.querySelectorAll<HTMLButtonElement>('.lang-option'));
    const langLabel = toggle?.querySelector<HTMLElement>('[data-lang-label]');

    let isOpen = false;

    const setActiveFor = (locale: string) => {
      options.forEach((option) => {
        const active = option.dataset.lang === locale;
        option.classList.toggle('is-active', active);
        option.setAttribute('aria-checked', String(active));
      });
    };

    const openDropdown = () => {
      dropdown?.classList.remove('opacity-0', 'invisible', 'scale-y-95');
      dropdown?.classList.add('opacity-100', 'visible', 'scale-y-100');
      toggle?.setAttribute('aria-expanded', 'true');
      isOpen = true;
    };

    const closeDropdown = () => {
      dropdown?.classList.add('opacity-0', 'invisible', 'scale-y-95');
      dropdown?.classList.remove('opacity-100', 'visible', 'scale-y-100');
      toggle?.setAttribute('aria-expanded', 'false');
      isOpen = false;
    };

    const focusActiveOption = () => {
      const locale = getActiveLocale();
      const active = options.find((option) => option.dataset.lang === locale) || options[0];
      active?.focus();
    };

    const moveFocus = (direction: number) => {
      const current = options.indexOf(document.activeElement as HTMLButtonElement);
      const next = (current === -1 ? 0 : current + direction + options.length) % options.length;
      options[next]?.focus();
    };

    toggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (isOpen) {
        closeDropdown();
      } else {
        openDropdown();
        focusActiveOption();
      }
    });

    toggle?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (!isOpen) {
          openDropdown();
          focusActiveOption();
        } else {
          moveFocus(e.key === 'ArrowDown' ? 1 : -1);
        }
      }
    });

    dropdown?.addEventListener('keydown', (e) => {
      if (!isOpen) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeDropdown();
        toggle?.focus();
      } else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        moveFocus(e.key === 'ArrowDown' ? 1 : -1);
      } else if (e.key === 'Home') {
        e.preventDefault();
        options[0]?.focus();
      } else if (e.key === 'End') {
        e.preventDefault();
        options[options.length - 1]?.focus();
      } else if (e.key === 'Tab') {
        closeDropdown();
      }
    });

    dropdown?.addEventListener('click', (e) => {
      const option = (e.target as HTMLElement).closest<HTMLButtonElement>('.lang-option');
      if (!option) return;

      const lang = option.dataset.lang;
      if (lang) {
        if (window.I18N) {
          window.I18N.setLocale(lang as 'en' | 'es');
        } else {
          window.dispatchEvent(new CustomEvent('language-change', { detail: { locale: lang } }));
        }
        setActiveFor(lang);
        if (langLabel) langLabel.textContent = lang.toUpperCase();
      }
      closeDropdown();
      toggle?.focus();
    });

    // Initial state
    setActiveFor(getActiveLocale());
    if (langLabel) langLabel.textContent = getActiveLocale().toUpperCase();

    return { group, isOpen: () => isOpen, closeDropdown, setActiveFor, toggle };
  }

  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-lang-toggle]')).map(wireLanguageToggle);

  // Close when clicking outside any open dropdown
  document.addEventListener('click', (e) => {
    groups.forEach(({ group, isOpen, closeDropdown }) => {
      if (isOpen() && !group.contains(e.target as Node)) closeDropdown();
    });
  });

  // Close all on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      groups.forEach(({ closeDropdown }) => closeDropdown());
    }
  });

  // Keep every instance in sync with the active locale
  window.addEventListener('language-changed', () => {
    const locale = getActiveLocale();
    groups.forEach(({ group, setActiveFor }) => {
      setActiveFor(locale);
      const label = group.querySelector<HTMLElement>('[data-lang-label]');
      if (label) label.textContent = locale.toUpperCase();
    });
  });
</script>

<style>
  .lang-option-code {
    @apply w-6 h-6 flex items-center justify-center rounded-lg text-caption font-mono font-medium bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400 transition-colors duration-200 shrink-0;
  }

  .lang-option-check {
    @apply opacity-0 scale-50 transition-all duration-200 shrink-0;
  }

  .lang-option.is-active {
    @apply bg-brand-500/10 dark:bg-brand-500/10;
  }

  .lang-option.is-active .lang-option-code {
    @apply bg-brand-500 text-white;
  }

  .lang-option.is-active .lang-option-check {
    @apply opacity-100 scale-100;
  }
</style>