---
interface Props {
  project: any;
  featured: boolean;
  index: number;
}

const { project, featured, index } = Astro.props;
const { title, description, technologies, github, demo, image, video, featured: isFeatured } = project.data;
const categories = [isFeatured ? 'featured' : '', ...technologies.map((t: string) => t.toLowerCase())].filter(Boolean);
---

<article 
  class="card card-hover overflow-hidden group"
  data-project-card
  data-categories={categories.join(',')}
  data-animate="slide-up"
  data-delay={String((index + 1) * 100)}
>
  <div class="relative aspect-video overflow-hidden bg-neutral-950">
    {video ? (
      /* Muted looped reel; plays while scrolled into view (observer in Scripts.astro).
         The image frontmatter doubles as the poster so the frame never looks bare. */
      <video
        src={video}
        poster={image || undefined}
        muted
        playsinline
        loop
        preload="metadata"
        disablepictureinpicture
        data-autoplay-inview
        aria-hidden="true"
        tabindex="-1"
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
      ></video>
    ) : image ? (
      <img 
        src={image} 
        alt=""
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full bg-gradient-to-br from-brand-500/20 to-accent-cyan/20 flex items-center justify-center">
        <svg class="w-16 h-16 text-brand-500/50" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    )}
    
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>
    
    {isFeatured && (
      <div class="absolute top-4 left-4">
        <span class="badge badge-primary" data-i18n="common.featured">Featured</span>
      </div>
    )}
    
    <div class="absolute bottom-4 left-4 right-4 opacity-0 group-hover:opacity-100 translate-y-4 group-hover:translate-y-0 transition-all duration-300">
      <div class="flex gap-3 justify-center">
        {demo && (
          <a 
            href={demo} 
            target="_blank" 
            rel="noopener noreferrer"
            class="btn btn-primary text-sm px-4 py-2"
            aria-label={`View live demo of ${title}`}
            data-i18n-attr="aria-label:projects.projectCard.viewLiveDemo"
            data-i18n-params={JSON.stringify({ title })}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            <span class="hidden sm:inline" data-i18n="common.liveDemo">Live Demo</span>
          </a>
        )}
        {github && (
          <a 
            href={github} 
            target="_blank" 
            rel="noopener noreferrer"
            class="btn btn-secondary text-sm px-4 py-2"
            aria-label={`View source code of ${title}`}
            data-i18n-attr="aria-label:projects.projectCard.viewSource"
            data-i18n-params={JSON.stringify({ title })}
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
            <span class="hidden sm:inline" data-i18n="common.sourceCode">Source Code</span>
          </a>
        )}
      </div>
    </div>
  </div>
  
  <div class="p-6">
    <div class="flex items-center gap-2 mb-3">
      <h3 class="font-display text-heading-md font-bold text-neutral-900 dark:text-neutral-100 group-hover:text-brand-500 dark:group-hover:text-brand-400 transition-colors">
        {title}
      </h3>
    </div>
    
    <p class="text-body-md text-neutral-600 dark:text-neutral-400 mb-4 line-clamp-3">
      {description}
    </p>
    
    <div class="flex flex-wrap gap-2" aria-label="Technologies used" data-i18n-attr="aria-label:common.technologies">
      {technologies.slice(0, 6).map((tech: string) => (
        <span class="tag">{tech}</span>
      ))}
      {technologies.length > 6 && (
        <span
          class="tag text-neutral-500 dark:text-neutral-500"
          data-i18n="projects.projectCard.moreCount"
          data-i18n-params={JSON.stringify({ count: technologies.length - 6 })}
        >
          +{technologies.length - 6} more
        </span>
      )}
    </div>
  </div>
</article>