---
---
<form 
  id="contact-form"
  class="card p-8 lg:p-10"
  method="POST"
  name="contact"
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-animate="slide-up"
  data-delay="300"
  novalidate
>
  <!-- Netlify Forms hidden fields -->
  <input type="hidden" name="form-name" value="contact" />
  <p class="hidden" aria-hidden="true">
    <label>Don't fill this out if you're human: <input name="bot-field" /></label>
  </p>
  
  <h3 class="font-display text-heading-lg font-bold text-neutral-900 dark:text-neutral-100 mb-8" data-i18n="contact.form.title">Send me a message</h3>
  
  <div class="grid gap-6">
    <div class="grid sm:grid-cols-2 gap-6">
      <!-- Name -->
      <div>
        <label for="name" class="label" data-i18n="contact.form.name">Your Name</label>
        <input 
          type="text" 
          id="name" 
          name="name" 
          class="input" 
          placeholder="John Doe"
          data-i18n-attr="placeholder:contact.form.namePlaceholder"
          autocomplete="name"
          required
        />
        <p class="error-message mt-2 hidden text-body-sm text-red-500" data-error-for="name"></p>
      </div>
      
      <!-- Email -->
      <div>
        <label for="email" class="label" data-i18n="contact.form.email">Email Address</label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          class="input" 
          placeholder="john@example.com"
          data-i18n-attr="placeholder:contact.form.emailPlaceholder"
          autocomplete="email"
          required
        />
        <p class="error-message mt-2 hidden text-body-sm text-red-500" data-error-for="email"></p>
      </div>
    </div>
    
    <!-- Subject -->
    <div>
      <label for="subject" class="label" data-i18n="contact.form.subject">Subject</label>
      <input 
        type="text" 
        id="subject" 
        name="subject" 
        class="input" 
        placeholder="Project inquiry"
        data-i18n-attr="placeholder:contact.form.subjectPlaceholder"
        required
      />
      <p class="error-message mt-2 hidden text-body-sm text-red-500" data-error-for="subject"></p>
    </div>
    
    <!-- Message -->
    <div>
      <label for="message" class="label" data-i18n="contact.form.message">Message</label>
      <textarea 
        id="message" 
        name="message" 
        class="input min-h-[160px] resize-y" 
        placeholder="Tell me about your project..."
        data-i18n-attr="placeholder:contact.form.messagePlaceholder"
        minlength="10"
        required
      ></textarea>
      <p class="error-message mt-2 hidden text-body-sm text-red-500" data-error-for="message"></p>
    </div>
    
    <!-- Submit -->
    <div class="flex flex-col sm:flex-row items-center gap-4">
      <button 
        type="submit" 
        class="btn-primary group w-full sm:w-auto"
        id="submit-button"
      >
        <span class="inline-flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
          <span data-submit-text>Send Message</span>
        </span>
      </button>
      <span class="text-body-sm text-neutral-500 dark:text-neutral-500" data-form-hint>
        Usually replies within 24-48 hours
      </span>
    </div>
    
    <!-- Status messages -->
    <div class="status-message hidden p-4 rounded-xl" role="alert" aria-live="polite">
      <div class="flex items-center gap-3">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path class="status-icon-success hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          <path class="status-icon-error hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <span class="text-body-sm font-medium" data-status-text></span>
      </div>
    </div>
  </div>
</form>

<script>
  const form = document.getElementById('contact-form');
  const submitButton = document.getElementById('submit-button');
  const submitText = submitButton?.querySelector('[data-submit-text]');
  const statusMessage = form?.querySelector('.status-message');
  const statusText = form?.querySelector('[data-status-text]');
  const statusIconSuccess = form?.querySelector('.status-icon-success');
  const statusIconError = form?.querySelector('.status-icon-error');
  
  // Get current language from localStorage
  function getCurrentLanguage(): string {
    return localStorage.getItem('locale') || 'en';
  }
  
  const messages = {
    en: {
      submitting: 'Sending...',
      submit: 'Send Message',
      success: 'Message sent successfully! I\'ll get back to you soon.',
      error: 'Failed to send message. Please try again or email me directly.',
      validation: {
        nameRequired: 'Name is required',
        emailRequired: 'Email is required',
        emailInvalid: 'Please enter a valid email address',
        subjectRequired: 'Subject is required',
        messageRequired: 'Message is required',
        messageMinLength: 'Message must be at least 10 characters'
      }
    },
    es: {
      submitting: 'Enviando...',
      submit: 'Enviar Mensaje',
      success: '¡Mensaje enviado con éxito! Te responderé pronto.',
      error: 'Error al enviar el mensaje. Por favor, inténtalo de nuevo o envíame un email directamente.',
      validation: {
        nameRequired: 'El nombre es obligatorio',
        emailRequired: 'El correo es obligatorio',
        emailInvalid: 'Por favor, ingresa un correo válido',
        subjectRequired: 'El asunto es obligatorio',
        messageRequired: 'El mensaje es obligatorio',
        messageMinLength: 'El mensaje debe tener al menos 10 caracteres'
      }
    }
  };
  
  function getMessages(): typeof messages.en {
    return messages[getCurrentLanguage() as keyof typeof messages] || messages.en;
  }
  
  function showStatus(type: 'success' | 'error', text: string) {
    statusMessage?.classList.remove('hidden');
    statusMessage?.classList.add('flex');
    
    if (type === 'success') {
      statusMessage?.classList.add('bg-emerald-500/10', 'text-emerald-600', 'dark:text-emerald-400', 'border', 'border-emerald-500/20');
      statusMessage?.classList.remove('bg-red-500/10', 'text-red-600', 'dark:text-red-400', 'border-red-500/20');
      statusIconSuccess?.classList.remove('hidden');
      statusIconError?.classList.add('hidden');
    } else {
      statusMessage?.classList.add('bg-red-500/10', 'text-red-600', 'dark:text-red-400', 'border', 'border-red-500/20');
      statusMessage?.classList.remove('bg-emerald-500/10', 'text-emerald-600', 'dark:text-emerald-400', 'border-emerald-500/20');
      statusIconSuccess?.classList.add('hidden');
      statusIconError?.classList.remove('hidden');
    }
    
    if (statusText) statusText.textContent = text;
    
    statusMessage?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    
    setTimeout(() => {
      statusMessage?.classList.add('hidden');
      statusMessage?.classList.remove('flex');
    }, 5000);
  }
  
  function setFieldError(fieldName: string, message: string) {
    const field = form?.querySelector<HTMLInputElement>(`[name="${fieldName}"]`);
    const errorElement = form?.querySelector(`[data-error-for="${fieldName}"]`);
    
    if (field && errorElement) {
      field.classList.add('border-red-500');
      errorElement.textContent = message;
      errorElement.classList.remove('hidden');
    }
  }
  
  function clearFieldError(fieldName: string) {
    const field = form?.querySelector<HTMLInputElement>(`[name="${fieldName}"]`);
    const errorElement = form?.querySelector(`[data-error-for="${fieldName}"]`);
    
    if (field && errorElement) {
      field.classList.remove('border-red-500');
      errorElement.classList.add('hidden');
    }
  }
  
  function validateForm(formData: FormData): boolean {
    const lang = getMessages();
    let isValid = true;
    
    // Validate name
    const name = String(formData.get('name') || '');
    if (!name) {
      setFieldError('name', lang.validation.nameRequired);
      isValid = false;
    } else {
      clearFieldError('name');
    }
    
    // Validate email
    const email = String(formData.get('email') || '');
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!email) {
      setFieldError('email', lang.validation.emailRequired);
      isValid = false;
    } else if (!emailRegex.test(email)) {
      setFieldError('email', lang.validation.emailInvalid);
      isValid = false;
    } else {
      clearFieldError('email');
    }
    
    // Validate subject
    const subject = String(formData.get('subject') || '');
    if (!subject) {
      setFieldError('subject', lang.validation.subjectRequired);
      isValid = false;
    } else {
      clearFieldError('subject');
    }
    
    // Validate message
    const message = String(formData.get('message') || '');
    if (!message) {
      setFieldError('message', lang.validation.messageRequired);
      isValid = false;
    } else if (message.length < 10) {
      setFieldError('message', lang.validation.messageMinLength);
      isValid = false;
    } else {
      clearFieldError('message');
    }
    
    return isValid;
  }
  
  // Clear errors on input
  form?.querySelectorAll('input, textarea').forEach(field => {
    field.addEventListener('input', () => {
      clearFieldError(field.getAttribute('name') || '');
    });
  });
  
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const lang = getMessages();
    
    // Validate
    if (!validateForm(formData)) {
      showStatus('error', lang.error);
      return;
    }
    
    // Update button state
    if (submitText) submitText.textContent = lang.submitting;
    submitButton?.setAttribute('disabled', 'true');
    submitButton?.classList.add('opacity-50', 'cursor-not-allowed');
    
    try {
      // Submit to Netlify Forms
      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(formData as any).toString()
      });
      
      if (response.ok) {
        form.reset();
        showStatus('success', lang.success);
        if (submitText) submitText.textContent = lang.submit;
      } else {
        throw new Error('Failed to submit');
      }
    } catch (error) {
      console.error('Form submission error:', error);
      showStatus('error', lang.error);
      if (submitText) submitText.textContent = lang.submit;
    } finally {
      submitButton?.removeAttribute('disabled');
      submitButton?.classList.remove('opacity-50', 'cursor-not-allowed');
    }
  });
  
  // Listen for language changes to update messages
  window.addEventListener('language-changed', () => {
    const lang = getMessages();
    if (!form?.querySelector('.status-message:not(.hidden)')) {
      if (submitText) submitText.textContent = lang.submit;
    }
  });
</script>