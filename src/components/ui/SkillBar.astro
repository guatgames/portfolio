---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<!--
  Skill chip. Styled here (not by the parent) because Astro scope-attributes
  only reach elements this component renders itself. Every ability shares the
  same neutral dot — no per-skill hue.
-->
<code class="skill-chip" data-stagger-child="fade-in">
  <span class="skill-chip-dot bg-[var(--color-text-secondary)]" aria-hidden="true"></span>
  <span>{name}</span>
</code>

<style>
  .skill-chip {
    @apply inline-flex items-center gap-2 px-2.5 py-1 text-caption font-medium;
    background: transparent;
    border: 1px solid var(--color-border-primary);
    color: var(--color-text-secondary);
    transition: border-color 0.3s ease, color 0.3s ease;
    white-space: nowrap;
  }

  .skill-chip:hover {
    border-color: var(--color-text-primary);
    color: var(--color-text-primary);
  }

  .skill-chip-dot {
    @apply w-1.5 h-1.5 shrink-0;
    border-radius: 0;
  }
</style>
