---
import LanguageToggle from '../ui/LanguageToggle.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
---
<div 
  id="mobile-menu"
  class="mobile-menu fixed inset-0 z-40 bg-white dark:bg-neutral-950 transform translate-x-full lg:hidden transition-transform duration-500 ease-out-expo"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
>
  <div class="flex flex-col h-full p-8 overflow-y-auto">
    <div class="flex items-center justify-between mb-12">
      <a href="/" class="block shrink-0" aria-label="Guatgames - Home">
        <img src="/images/favico.jpeg" alt="Guatgames" class="w-10 h-10 rounded-xl object-cover dark:hidden" width="40" height="40" loading="eager" />
        <img src="/images/favico-dark.jpeg" alt="Guatgames" class="w-10 h-10 rounded-xl object-cover hidden dark:block" width="40" height="40" loading="eager" />
      </a>
      <button
        id="mobile-menu-close"
        class="btn-icon"
        aria-label="Close menu"
        data-i18n-attr="aria-label:accessibility.closeMenu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    
    <nav aria-label="Mobile navigation" data-i18n-attr="aria-label:navigation.mobileNav">
      <ul class="flex flex-col gap-2 mb-12">
        <li>
          <a href="#about" class="mobile-nav-link" data-i18n="navigation.about">About</a>
        </li>
        <li>
          <a href="#projects" class="mobile-nav-link" data-i18n="navigation.projects">Projects</a>
        </li>
        <li>
          <a href="#technologies" class="mobile-nav-link" data-i18n="navigation.technologies">Technologies</a>
        </li>
        <li>
          <a href="#blog" class="mobile-nav-link" data-i18n="navigation.blog">Blog</a>
        </li>
        <li>
          <a href="#contact" class="mobile-nav-link" data-i18n="navigation.contact">Contact</a>
        </li>
      </ul>
    </nav>
    
    <div class="flex flex-col gap-4 mt-auto pt-8 border-t border-neutral-200 dark:border-neutral-800">
      <LanguageToggle />
      <ThemeToggle />
      <div class="flex items-center gap-4">
        <a href="mailto:adalfaroochoa@gmail.com" class="btn-primary w-full justify-center" data-i18n="hero.ctaSecondary">
          Get in Touch
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const menu = document.getElementById('mobile-menu');
  const closeBtn = document.getElementById('mobile-menu-close');
  const links = menu?.querySelectorAll('.mobile-nav-link');
  const openBtn = document.getElementById('mobile-menu-button');
  
  function openMenu() {
    menu?.classList.remove('translate-x-full');
    menu?.classList.add('translate-x-0');
    document.body.style.overflow = 'hidden';
    openBtn?.setAttribute('aria-expanded', 'true');
    closeBtn?.focus();
  }
  
  function closeMenu() {
    menu?.classList.add('translate-x-full');
    menu?.classList.remove('translate-x-0');
    document.body.style.overflow = '';
    window.dispatchEvent(new CustomEvent('mobile-menu-closed'));
    openBtn?.focus();
  }
  
  closeBtn?.addEventListener('click', closeMenu);
  
  links?.forEach(link => {
    link.addEventListener('click', closeMenu);
  });
  
  // Keep focus inside the open panel so aria-modal is honoured
  menu?.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const focusables = menu?.querySelectorAll<HTMLElement>('a[href], button:not([disabled])');
    if (!focusables || focusables.length === 0) return;
    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu?.classList.contains('translate-x-full')) {
      closeMenu();
    }
  });
  
  // Listen for menu open event from MobileMenuButton
  window.addEventListener('open-mobile-menu', openMenu);
</script>

<style>
  .mobile-nav-link {
    @apply block px-4 py-4 text-heading-sm font-medium text-neutral-900 dark:text-neutral-100 rounded-xl hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors;
  }
</style>