---
---
<button
  type="button"
  class="btn-icon relative overflow-hidden group"
  aria-label="Toggle theme"
  role="switch"
  aria-checked="false"
  data-theme-toggle
>
  <span class="relative z-10 flex items-center justify-center">
    <!-- Sun icon (shown in dark mode) -->
    <svg class="w-5 h-5 text-amber-500 rotate-90 scale-0 transition-transform duration-300 group-data-[theme=dark]:rotate-0 group-data-[theme=dark]:scale-100" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
    </svg>
    <!-- Moon icon (shown in light mode) -->
    <svg class="w-5 h-5 text-neutral-600 dark:text-neutral-400 rotate-0 scale-100 transition-transform duration-300 group-data-[theme=dark]:-rotate-90 group-data-[theme=dark]:scale-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
    </svg>
    <!-- System icon (shown in system mode) -->
    <svg class="w-5 h-5 text-neutral-600 dark:text-neutral-400 absolute opacity-0 scale-50 transition-all duration-300 group-data-[theme=system]:opacity-100 group-data-[theme=system]:scale-100 group-data-[theme=system]:rotate-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
    </svg>
  </span>
  <div class="absolute inset-0 bg-brand-500 scale-x-0 origin-right transition-transform duration-300 group-hover:scale-x-100 group-hover:origin-left" aria-hidden="true"></div>
</button>

<script>
  // Multi-instance safe: header + mobile menu both render this component.
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const html = document.documentElement;

  function updateThemeUI(toggle: HTMLButtonElement, theme: string) {
    toggle.setAttribute('data-theme', theme);
    toggle.setAttribute('aria-checked', theme === 'dark' ? 'true' : 'false');
  }

  function getCurrentTheme(): 'light' | 'dark' | 'system' {
    const attr = html.getAttribute('data-theme');
    if (attr === 'light' || attr === 'dark' || attr === 'system') return attr;
    // Fallback before the theme runtime initializes:
    if (html.classList.contains('dark')) return 'dark';
    return 'system';
  }

  toggles.forEach((toggle) => {
    updateThemeUI(toggle, getCurrentTheme());

    toggle.addEventListener('click', () => {
      const themes = ['light', 'dark', 'system'] as const;
      const currentIndex = themes.indexOf(getCurrentTheme());
      const nextTheme = themes[(currentIndex + 1) % themes.length];

      // Let the global theme runtime apply it
      if (window.THEME) {
        window.THEME.setTheme(nextTheme);
      } else {
        window.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: nextTheme } }));
      }
    });
  });

  // Keep icons in sync with the active theme
  window.addEventListener('theme-changed', (e: CustomEvent) => {
    toggles.forEach((toggle) => updateThemeUI(toggle, e.detail.theme));
  });

  // Follow system changes while in system mode
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (getCurrentTheme() === 'system') {
      toggles.forEach((toggle) => updateThemeUI(toggle, 'system'));
    }
  });
</script>