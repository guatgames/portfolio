---
import { techLogos } from '../../data/tech-icons';

interface Props {
  tech: any;
  color: string;
  index: number;
}

const { tech, index } = Astro.props;
const { name } = tech;

// Case-insensitive lookup: the technologies JSON uses ids like "MySQL"/"GameMaker"
const logo = techLogos[tech.id] ?? techLogos[String(tech.id).toLowerCase()];
// Multi-color logos (e.g. Flet) carry their own per-path fills.
const hasOwnColors = Boolean(logo?.fills?.length);

// A few official marks are near-black; they need a light variant on the night
// ground, while the rest keep their exact brand hue in both themes.
function isDarkColor(hex: string): boolean {
  const h = hex.replace('#', '');
  const r = parseInt(h.slice(0, 2), 16) / 255;
  const g = parseInt(h.slice(2, 4), 16) / 255;
  const b = parseInt(h.slice(4, 6), 16) / 255;
  const lin = (c: number) => (c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4));
  return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b) < 0.12;
}

const logoIsDark = logo ? isDarkColor(logo.hex) : false;
const logoClass = !hasOwnColors && logoIsDark ? 'text-neutral-900 dark:text-white' : '';
const logoStyle = !hasOwnColors && logo && !logoIsDark ? `color: #${logo.hex}` : undefined;
---

<div
  class="card card-hover p-5 group relative flex flex-col items-center text-center"
  data-animate="slide-up"
  data-delay={String((index + 1) * 50)}
  data-reveal-child
>
  <div class="absolute top-0 left-0 right-0 h-px bg-neutral-900 dark:bg-neutral-100 opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>

  <div class="relative flex flex-col items-center">
    <div class="w-14 h-14 border-2 border-[var(--color-border-primary)] flex items-center justify-center mb-4 text-[var(--color-text-secondary)] transition-colors duration-300 group-hover:border-[var(--color-text-primary)] group-hover:text-[var(--color-text-primary)]">
      {logo ? (
        <svg
          data-tech-logo="true"
          viewBox={logo.viewBox}
          class={`w-8 h-8 ${logoClass}`}
          style={logoStyle}
          fill={hasOwnColors ? undefined : 'currentColor'}
          aria-hidden="true"
        >
          {logo.paths.map((path: string, i: number) => (
            <path
              d={path}
              fill={logo.fills?.[i] ?? undefined}
              opacity={logo.opacities?.[i] ?? undefined}
            />
          ))}
        </svg>
      ) : (
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
        </svg>
      )}
    </div>

    <h4 class="font-display text-heading-sm font-bold text-neutral-900 dark:text-neutral-100">
      {name}
    </h4>
  </div>
</div>
