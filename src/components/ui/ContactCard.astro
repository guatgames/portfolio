---
interface Props {
  icon: 'email' | 'github' | 'linkedin' | 'twitter';
  title: string;
  value: string;
  other?: string;
  href: string;
  description: string;
  i18nKey?: string;
}

const { icon, title, value, href, description, i18nKey, other } = Astro.props;

const icons: Record<Props['icon'], { path: string; fill: boolean }> = {
  email: {
    path: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />',
    fill: false,
  },
  github: {
    path: '<path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>',
    fill: true,
  },
  linkedin: {
    path: '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>',
    fill: true,
  },
  twitter: {
    path: '<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>',
    fill: true,
  },
};

const colorMaps: Record<Props['icon'], { iconBg: string; text: string; hoverText: string }> = {
  email: {
    iconBg: 'bg-brand-500/10',
    text: 'text-brand-500',
    hoverText: 'hover:text-brand-600 dark:hover:text-brand-400',
  },
  github: {
    iconBg: 'bg-accent-cyan/10',
    text: 'text-accent-cyan',
    hoverText: 'hover:text-accent-cyan dark:hover:text-accent-cyan',
  },
  linkedin: {
    iconBg: 'bg-accent-magenta/10',
    text: 'text-accent-magenta',
    hoverText: 'hover:text-accent-magenta dark:hover:text-accent-magenta',
  },
  twitter: {
    iconBg: 'bg-accent-lime/10',
    text: 'text-accent-lime',
    hoverText: 'hover:text-accent-lime dark:hover:text-accent-lime',
  },
};

const classes = colorMaps[icon];
const iconDef = icons[icon];
---

<div 
  class="card card-hover p-6 flex items-start gap-4"
  data-contact-card
  data-animate="slide-up"
  data-delay="200"
  data-reveal-child
>
  <span class={`w-12 h-12 shrink-0 rounded-xl ${classes.iconBg} flex items-center justify-center`}>
    <svg class={`w-6 h-6 ${classes.text}`} fill={iconDef.fill ? 'currentColor' : 'none'} stroke={iconDef.fill ? 'none' : 'currentColor'} viewBox="0 0 24 24" aria-hidden="true">
      <set:html>{iconDef.path}</set:html>
    </svg>
  </span>
  
  <div class="flex-1 min-w-0">
    <h4 class="font-display text-heading-sm font-bold text-neutral-900 dark:text-neutral-100 mb-1" data-i18n={i18nKey ? `${i18nKey}.title` : undefined}>{title}</h4>
    <a 
      href={href}
      target={icon === 'email' ? undefined : '_blank'}
      rel={icon === 'email' ? undefined : 'noopener noreferrer'}
      class={`font-mono text-body-md ${classes.text} ${classes.hoverText} transition-colors break-all`}
    >
      {value}
    </a>
    <p class="text-body-sm text-neutral-600 dark:text-neutral-400 mt-1" data-i18n={i18nKey ? `${i18nKey}.description` : undefined}>{description}</p>
  </div>
  
  <button 
    class="copy-btn shrink-0 p-2 rounded-lg text-neutral-500 dark:text-neutral-500 hover:text-brand-500 dark:hover:text-brand-400 hover:bg-brand-500/10 transition-all duration-300"
    data-copy-value={other}
    aria-label={`Copy ${title} value`}
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
    </svg>
  </button>
</div>